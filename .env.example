# 明朝模拟器 — 配置
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# === 本地数据库（SQLite 文件） ===
# 数据库文件放在 data/raw/ 对应子目录下即可自动注册
# 目前注册的数据库：
#   人物传记/ — CBDB (Harvard China Biographical Database)
# 后续可新增：
#   地方志/  — 地方志数据库
#   地理/    — CHGIS 历史地理数据库
#   实录/    — 明实录文本数据库

# GitHub Personal Access Token (用于 gh CLI 推送代码和创建仓库)
# 获取方式: GitHub → Settings → Developer settings → Personal access tokens → Generate new token
# 需要的权限: repo (全部)
GITHUB_TOKEN=ghp_your_token_here

# Cloudflare API Token (用于 wrangler 部署 Worker)
# 获取方式: Cloudflare Dashboard → My Profile → API Tokens → Create Token
# 推荐使用 "Edit Cloudflare Workers" 模板
CLOUDFLARE_API_TOKEN=cfut_your_token_here

# === 史料原文检索 API ===
# 中国哲学书电子化计划 (ctext.org)
CTEXT_API_URL=https://api.ctext.org
CTEXT_API_KEY=

# === 故宫博物院 ===
GUGONG_API_URL=https://api.dpm.org.cn
GUGONG_API_KEY=

# === LLM 服务 ===
# OpenAI 兼容接口
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
# 国内替代（DeepSeek / 智谱 / 通义千问）
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=

# === 向量数据库 (RAG) ===
# ChromaDB 本地路径（留空=内存模式）
CHROMA_PERSIST_DIR=
EMBEDDING_MODEL=text-embedding-3-small

# === 本地数据库路径（可选，默认自动扫描 data/raw/） ===
# 仅当数据库不在 data/raw/ 下时需配置
# CBDB_PATH=data/raw/人物传记/cbdb_20260509.sqlite3
# CHGIS_PATH=
# LOCAL_GAZETTEER_PATH=
